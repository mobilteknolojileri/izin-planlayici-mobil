      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"employment_type\" TEXT NOT NULL, \"employment_start_date\" TEXT NOT NULL, \"birth_date\" TEXT NULL, \"work_days\" TEXT NOT NULL, \"weekly_rest_day\" INTEGER NOT NULL, \"saturday_counts_as_leave\" INTEGER NOT NULL CHECK (\"saturday_counts_as_leave\" IN (0, 1)), \"half_day_deduction\" TEXT NOT NULL, \"daily_working_hours\" REAL NOT NULL, \"prior_service_years\" INTEGER NOT NULL, \"prior_service_months\" INTEGER NOT NULL, \"prior_service_days\" INTEGER NOT NULL, \"is_underground\" INTEGER NOT NULL CHECK (\"is_underground\" IN (0, 1)), \"contract_extra_days\" INTEGER NOT NULL, \"leave_used_before_tracking\" REAL NOT NULL, \"is_teacher\" INTEGER NOT NULL CHECK (\"is_teacher\" IN (0, 1)), \"administrative_leave_days\" TEXT NOT NULL, \"absence_periods\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(id) > 0), CHECK (employment_type IN ('laborLaw', 'civilServant')), CHECK (date(employment_start_date) IS employment_start_date), CHECK (date(birth_date) IS birth_date), CHECK (json_type(work_days) = 'array'), CHECK (weekly_rest_day BETWEEN 1 AND 7), CHECK (half_day_deduction IN ('zero', 'half', 'full')), CHECK (daily_working_hours > 0), CHECK (prior_service_years >= 0), CHECK (prior_service_months >= 0), CHECK (prior_service_days >= 0), CHECK (contract_extra_days >= 0), CHECK (leave_used_before_tracking >= 0), CHECK (json_type(administrative_leave_days) = 'array'), CHECK (json_type(absence_periods) = 'array')) STRICT;"
        }
      ]
    },
