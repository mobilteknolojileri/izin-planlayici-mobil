<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (task 14). LeaveWidgetProvider sets the text, the
     screen reader description and the background from data written in
     Dart. The defaults below show until the app has run once, and in the
     widget picker preview.

     All lines live in one auto-sized TextView, so a large system font
     shrinks the lines together instead of cutting any of them. The base
     size is in sp. The auto-size floor is in dp on purpose: an sp floor
     grows with the font scale and would let text overflow at 200%. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/widget_description">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_light" />

    <TextView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoSizeMaxTextSize="17sp"
        android:autoSizeMinTextSize="9dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical|start"
        android:importantForAccessibility="no"
        android:lineSpacingMultiplier="1.1"
        android:padding="16dp"
        android:text="@string/widget_description"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        tools:ignore="SpUsage"
        tools:targetApi="o" />
</FrameLayout>
