<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background in the dark theme: the hero card gradient,
     AppPalette.blue37 to blue13, top left to bottom right. White text
     reaches 7.1:1 and blue91 text 5.6:1 on the lighter end. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="315"
        android:endColor="#FF0D1A5C"
        android:startColor="#FF2447D6"
        android:type="linear" />
</shape>
